# ianOS credentials — copy to .env and fill in when ready

# Claude agent runs (pick one)
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# SimpleFIN — Chase checking ($1.50/mo at bridge.simplefin.org)
# Run: make setup-simplefin TOKEN=<setup-token>
SIMPLEFIN_ACCESS_URL=

# SnapTrade — Fidelity stocks (free tier at snaptrade.com)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# Plaid — Chase + Capital One bank/card accounts (Trial: production data, up to 10 Items)
# First set client id/secret and choose sandbox or production. The local ianOS
# API exchanges Link's public token and writes the two access-token values.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
# Required for Chase/Capital One OAuth in production; must be an HTTPS URL
# registered in the Plaid Dashboard. Leave blank only for Sandbox/local testing.
PLAID_REDIRECT_URI=
PLAID_ACCESS_TOKEN_CHASE=
PLAID_ACCESS_TOKEN_CAPITAL_ONE=

# Canvas — optional live calendar feed (SPEC-v32 Part C). This URL is a
# bearer secret: whoever holds it can read Ian's whole term calendar. Get it
# from Canvas > Calendar > Calendar Feed (the private iCal link), never a
# password or API token. make import-canvas FILE=... still works for a
# manual one-off snapshot if you'd rather not configure this.
CANVAS_ICS_URL=

# iCloud — two-way sync of the day plan (SPEC-v7 Phase C)
# App-specific password from appleid.apple.com → Sign-In & Security (NOT your
# real Apple ID password). ianOS writes only to a dedicated "ianOS Plan"
# calendar; all other calendars are read as read-only commitments.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
ICLOUD_CALDAV_URL=https://caldav.icloud.com/
IANOS_TZ=America/Chicago

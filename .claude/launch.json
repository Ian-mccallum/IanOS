{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ianos-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["api.main:app", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "ianos-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "dashboard"],
      "port": 5173,
      "autoPort": true
    }
  ]
}

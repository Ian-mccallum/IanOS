<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ianos.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__IANOS_DIR__/scripts/backup.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__IANOS_DIR__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__IANOS_DIR__/data/backup.log</string>
    <key>StandardErrorPath</key>
    <string>__IANOS_DIR__/data/backup.log</string>
</dict>
</plist>
